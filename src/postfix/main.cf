# Postfix 3.8 (Ubuntu 24.04) for dydev10/mailbox.
# myhostname and mydomain default from the compose "hostname"; relayhost
# and smtpd_tls_chain_files are set by /entrypoint on every start.
compatibility_level = 3.6
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
maillog_file = /dev/stdout

# --- identity and local delivery (only localhost is local; users are virtual)
myorigin = $mydomain
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = ipv4
recipient_delimiter = +
mailbox_size_limit = 0
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# --- virtual mailboxes and aliases in SQLite, delivered by Dovecot LMTP.
# smtpd is chrooted, so lookups go through proxymap (proxy:).
virtual_mailbox_domains = proxy:sqlite:/etc/postfix/sqlite/dom-vmbox.cf
virtual_mailbox_maps    = proxy:sqlite:/etc/postfix/sqlite/maps-vmbox.cf
virtual_alias_maps      = proxy:sqlite:/etc/postfix/sqlite/maps-valias.cf
virtual_transport       = lmtp:unix:private/dovecot-lmtp
smtpd_sender_login_maps = proxy:sqlite:/etc/postfix/sqlite/maps-sender-login.cf
# proxymap opens only the tables named here, so a chrooted daemon cannot make
# it read anything else. This list is narrower than Postfix's built-in
# default: if you later add another proxy: map (transport_maps, for example),
# add its parameter here too, or Postfix logs "table not approved for proxy
# read access" and the lookup fails.
proxy_read_maps = $local_recipient_maps $mydestination $mynetworks
    $virtual_alias_maps $virtual_mailbox_domains $virtual_mailbox_maps
    $smtpd_sender_login_maps

# --- outbound: everything goes through the relay, over TLS, with SASL
smtp_sasl_auth_enable = yes
# One line, "[relay]:port user:password", from the compose secret. texthash:
# needs no postmap; Postfix opens it as root before entering the chroot.
# After changing the secret: postfix reload.
smtp_sasl_password_maps = texthash:/run/secrets/relay_sasl
smtp_sasl_security_options = noanonymous
# secure: TLS is required AND the relay's certificate must match the host
# name in RELAY_HOST and chain to a trusted CA, so nobody can pose as the
# relay to collect the password. The CA bundle comes from ca-certificates;
# Postfix reads it before entering the chroot.
# If you ever deliver directly (no relayhost), change this back to may or dane.
smtp_tls_security_level = secure
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# --- inbound TLS; one certificate per hostname via SNI
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
tls_server_sni_maps = hash:/etc/postfix/vmail_ssl.map

# --- SASL via Dovecot; enabled only on 587/465 in master.cf
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous

# --- port 25 restrictions
smtpd_helo_required = yes
# Don't answer VRFY: it would tell anyone which addresses exist.
disable_vrfy_command = yes
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination

# --- postscreen: drop bots before smtpd. Listing codes are filtered so
# a resolver error reply is not counted as a hit.
postscreen_access_list = permit_mynetworks
postscreen_dnsbl_sites =
    zen.spamhaus.org=127.0.0.[2..11]*3
    bl.spamcop.net=127.0.0.2*2
    psbl.surriel.com=127.0.0.2*2
    bl.mailspike.net=127.0.0.2*2
    list.dnswl.org=127.0.[0..255].[0..3]*-3
postscreen_dnsbl_threshold = 3
postscreen_dnsbl_action = enforce
postscreen_greet_action = enforce