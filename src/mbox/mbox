#!/bin/bash
# mbox: admin tool for the mailbox container.
# Run "mbox" for a menu, or "mbox help" for the commands.
# From the VM: sudo docker exec -it mailbox mbox
set -euo pipefail

# The scripts that do the work live next to this file, in utils/
UTILS="$(dirname "$(readlink -f "$0")")/utils"

show_help() {
  echo "mbox: mailbox admin tool"
  echo
  echo "  mbox seed DOMAIN [ADMIN]   set up a domain: ADMIN@ (default admin) and test@"
  echo "                             mailboxes, postmaster@ and abuse@ to the admin"
  echo "  mbox passwd USER@DOMAIN    set a new password (also for a forgotten one)"
  echo "  mbox help                  this list"
  echo
  echo "Run mbox with no arguments for a menu."
}

show_menu() {
  echo "mbox: mailbox admin"
  echo "  1) Seed a domain"
  echo "  2) Forgot password / set a password"
  echo "  q) Quit"
  read -r -p "Choose: " choice

  case "$choice" in
    1)
      read -r -p "Domain: " domain
      read -r -p "Admin mailbox name [admin]: " admin
      "$UTILS/seed.sh" "$domain" "${admin:-admin}"
      ;;
    2)
      read -r -p "Address (user@domain): " email
      "$UTILS/passwd.sh" "$email"
      ;;
  esac
}

command="${1:-}"
case "$command" in
  seed)   shift; "$UTILS/seed.sh" "$@" ;;
  passwd) shift; "$UTILS/passwd.sh" "$@" ;;
  help)   show_help ;;
  "")     if [ -t 0 ]; then show_menu; else show_help; fi ;;   # menu only in a terminal
  *)      show_help >&2; exit 1 ;;
esac
