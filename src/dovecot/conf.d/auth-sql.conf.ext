# The password query also returns userdb_home/uid/gid, so the prefetch
# userdb answers logins without a second query. The SQL userdb is still
# needed for LMTP delivery and doveadm.
passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
userdb {
  driver = prefetch
}
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}