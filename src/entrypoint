#!/bin/bash
# Prepares config from the environment, then starts supervisord.
# Safe to run on every start: it overwrites what it generates, never appends.
set -euo pipefail

# Required: stop with a message if missing
: "${MAIL_DOMAIN:?set MAIL_DOMAIN in .env}"
: "${RELAY_HOST:?set RELAY_HOST in .env (all outbound mail goes through a relay)}"

# Optional, with defaults
MAIL_HOSTNAME=${MAIL_HOSTNAME:-$(hostname -f)}
OTHER_HOSTS=${OTHER_HOSTS:-}
LOCAL_RESOLVER=${LOCAL_RESOLVER:-no}

CERTS=/etc/letsencrypt/live
DB=/etc/mailsql/mail.sqlite

# All TLS hostnames: this server's name first, then OTHER_HOSTS (commas to spaces)
read -r -a HOSTS <<< "$MAIL_HOSTNAME ${OTHER_HOSTS//,/ }"

for h in "${HOSTS[@]}"; do
  [ -r "$CERTS/$h/fullchain.pem" ] || { echo "entrypoint: no certificate in $CERTS/$h" >&2; exit 1; }
done

# --- database: created on first start, permissions fixed every start.
# Group postfix: Postfix daemons drop extra groups and keep only their
# main one, so proxymap can read the file only through group "postfix".
# Dovecot's auth-worker runs as root. Only root writes.
install -d -o root -g postfix -m 0750 /etc/mailsql
# First start only (file missing or empty): load the schema.
# -bail stops at the first error; a half-built file is removed so the
# next start retries instead of running on a broken database.
if [ ! -s "$DB" ]; then
  sqlite3 -bail "$DB" < /usr/share/mailbox/schema.sql || { rm -f "$DB"; exit 1; }
fi
chown root:postfix "$DB"
chmod 0640 "$DB"

# --- mail storage: the top folder only (restores run chown -R themselves)
install -d -o vmail -g vmail -m 0750 /home/vmail

# --- DNS: a local resolver, because Spamhaus refuses public resolvers
if [ "$LOCAL_RESOLVER" = yes ]; then
  unbound-anchor -a /var/lib/unbound/root.key || true   # exits 1 after an update
  chown -f unbound:unbound /var/lib/unbound/root.key || true
  printf '[program:unbound]\ncommand=/usr/sbin/unbound -d\npriority=10\nautorestart=true\nstdout_logfile=/dev/stdout\nstdout_logfile_maxbytes=0\nredirect_stderr=true\n' \
    > /etc/supervisor/conf.d/unbound.conf
  echo 'nameserver 127.0.0.1' > /etc/resolv.conf
else
  rm -f /etc/supervisor/conf.d/unbound.conf
fi

# --- Postfix (myhostname and mydomain default from the compose hostname;
# relay credentials are read straight from the secret via texthash:)
# All outbound mail goes to the relay from .env
postconf -e "relayhost=$RELAY_HOST"
# Default certificate (key, then chain) for this server's own hostname
postconf -e "smtpd_tls_chain_files=$CERTS/$MAIL_HOSTNAME/privkey.pem, $CERTS/$MAIL_HOSTNAME/fullchain.pem"

# Local mail (Postfix's notices to postmaster, anything for root) goes to
# the postmaster@ alias in SQLite instead of /var/mail inside the container.
printf 'postmaster: root\nroot: postmaster@%s\n' "$MAIL_DOMAIN" > /etc/aliases

# Rebuild /etc/aliases.db from it (Postfix reads the .db, not the text file)
newaliases

: > /etc/postfix/vmail_ssl.map
for h in "${HOSTS[@]}"; do
  echo "$h $CERTS/$h/privkey.pem $CERTS/$h/fullchain.pem" >> /etc/postfix/vmail_ssl.map
done
postmap -F hash:/etc/postfix/vmail_ssl.map      # source kept for renewals

# Postfix's chrooted services need copies of these files
install -d /var/spool/postfix/etc
for f in resolv.conf hosts services nsswitch.conf localtime; do
  if [ -e "/etc/$f" ]; then cp -L "/etc/$f" "/var/spool/postfix/etc/$f"; fi
done

# --- Dovecot: default certificate, one per extra hostname, LMTP postmaster
{
  echo "# Written by /entrypoint on every start. Do not edit."
  echo "ssl_cert = <$CERTS/$MAIL_HOSTNAME/fullchain.pem"
  echo "ssl_key = <$CERTS/$MAIL_HOSTNAME/privkey.pem"
  for h in "${HOSTS[@]:1}"; do
    echo "local_name $h {"
    echo "  ssl_cert = <$CERTS/$h/fullchain.pem"
    echo "  ssl_key = <$CERTS/$h/privkey.pem"
    echo "}"
  done
  echo "protocol lmtp {"
  echo "  postmaster_address = postmaster@$MAIL_DOMAIN"
  echo "}"
} > /etc/dovecot/conf.d/99-generated.conf

exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf