# Copy to .env and edit. The server's own name comes from compose "hostname".
# Domain used for postmaster@ in bounces:
MAIL_DOMAIN=example.com
# Extra TLS hostnames served by this box, comma-separated (may be empty):
OTHER_HOSTS=
# Outbound relay. Its login goes in ./secrets/relay_sasl as one line:
#   [smtp.relayexample.com]:2525 postmaster@example.com:PASSWORD
RELAY_HOST=[smtp.relayexample.com]:2525
# Run unbound inside the container for Spamhaus lookups (yes/no).
# Off by default: turn on once the VM's IP has a PTR record.
LOCAL_RESOLVER=no